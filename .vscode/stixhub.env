# Environment for the VS Code launch configurations (matches compose.yml).
PYTHONPATH=src
STIX_HUB_DATABASE_HOST=localhost
STIX_HUB_DATABASE_PORT=5432
STIX_HUB_DATABASE_NAME=app
STIX_HUB_DATABASE_USER=postgres
STIX_HUB_DATABASE_PASS=postgres
STIX_HUB_DATABASE_ENGINE_ECHO=false
STIX_HUB_PLATFORM_CONFIG=platform_config.yaml
STIX_HUB_ADMIN_API_KEY=changeme
# One secret per collector in platform_config.yaml (at least 16 characters).
STIX_HUB_COLLECTOR_SECRETS__MITRE_ATTACK=change-me-mitre-attack
