{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STIXHub: uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "src",
            "cwd": "${workspaceFolder}/platform/",
            "env": {
                "STIX_HUB_DATABASE_HOST": "localhost",
                "STIX_HUB_DATABASE_PORT": "5432",
                "STIX_HUB_DATABASE_NAME": "app",
                "STIX_HUB_DATABASE_USER": "postgres",
                "STIX_HUB_DATABASE_PASS": "postgres",
                "STIX_HUB_DATABASE_USE_NULLPOOL": "false",
                "STIX_HUB_DATABASE_ENGINE_ECHO": "true",
                "STIX_HUB_BUCKET_REPO_BACKEND": "database",
                "STIX_HUB_PLATFORM_CONFIG": "../platform_config.yaml",
                "STIX_HUB_ADMIN_API_KEY": "aa"
            }
        }
    ]
}
