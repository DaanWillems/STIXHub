{
    // Debug the API server and the pipeline worker separately.
    // Needs PostgreSQL (`docker compose up -d`) and a selected Python interpreter
    // with the project installed (`pip install -e ".[dev]"`).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STIXHub: server",
            "type": "debugpy",
            "request": "launch",
            "module": "src",
            "args": ["--mode", "server"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/stixhub.env"
        },
        {
            "name": "STIXHub: worker",
            "type": "debugpy",
            "request": "launch",
            "module": "src",
            "args": ["--mode", "worker"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/stixhub.env"
        }
    ]
}
